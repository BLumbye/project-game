# Public domain pointing at the server, used for automatic HTTPS
DOMAIN=game.example.com

# PocketBase admin account, created on first start only (admin UI at https://<DOMAIN>/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please

# App image tag to deploy (latest, <branch>, sha-<commit>)
TAG=latest

# Seconds between checks for a new app image
UPDATE_INTERVAL=300
